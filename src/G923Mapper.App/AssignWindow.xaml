<Window x:Class="G923Mapper.App.AssignWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assign a wheel control" Width="600" SizeToContent="Height" MinHeight="260" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel Margin="16">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtProfile" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Press Record, then press the wheel button or pedal (or turn the wheel) you want to feed this control. Options for it (invert, half of the axis, deadzone and so on) appear underneath. Everything is saved straight away." />
                <StackPanel x:Name="Rows" Margin="0,14,0,0" />
                <TextBlock x:Name="TxtStatus" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Success}" />
            </StackPanel>
        </Border>
        <DockPanel Margin="0,12,0,0">
            <Button x:Name="EditAllButton" DockPanel.Dock="Left" Content="Edit all rules…" Style="{StaticResource Secondary}" Click="EditAll_Click" />
            <Button Content="Done" Style="{StaticResource Primary}" MinWidth="100" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="Done_Click" />
        </DockPanel>
    </StackPanel>
</Window>
