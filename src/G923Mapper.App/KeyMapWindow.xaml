<Window x:Class="G923Mapper.App.KeyMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Key or mouse mapping" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="16">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtProfile" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />

                <TextBlock Text="WHEEL CONTROL" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                <DockPanel>
                    <Button x:Name="RecordButton" DockPanel.Dock="Right" Content="Record" MinWidth="84" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="Record_Click" />
                    <TextBox x:Name="FromBox" Padding="8,6" ToolTip="The wheel button or pedal, for example paddleR or clutch. Press Record to pick it by using it." />
                </DockPanel>

                <TextBlock Text="PRESSES THIS KEY OR MOUSE BUTTON" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                <DockPanel>
                    <Button x:Name="CaptureButton" DockPanel.Dock="Right" Content="Press a key" MinWidth="84" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="Capture_Click" />
                    <ComboBox x:Name="KeyBox" IsEditable="True" Padding="8,6" />
                </DockPanel>

                <TextBlock x:Name="TxtSafety" Margin="0,12,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtStatus" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Success}" />
            </StackPanel>
        </Border>
        <DockPanel Margin="0,12,0,0">
            <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="Remove" Style="{StaticResource Secondary}" Click="Remove_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Secondary}" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Save" Style="{StaticResource Primary}" MinWidth="100" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
