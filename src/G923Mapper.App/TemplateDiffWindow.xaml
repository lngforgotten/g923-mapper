<Window x:Class="G923Mapper.App.TemplateDiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Differences from the template" Width="700" Height="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="TxtHelp" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Rows" />
            </ScrollViewer>
        </Border>
        <DockPanel Grid.Row="4">
            <Button x:Name="ResetAllButton" DockPanel.Dock="Left" Content="Reset everything" Style="{StaticResource Secondary}" Click="ResetAll_Click" />
            <Button Content="Close" Style="{StaticResource Primary}" MinWidth="100" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
