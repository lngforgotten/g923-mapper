<Window x:Class="G923Mapper.App.IgnoredTipsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ignored tips" Width="520" Height="380" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource Muted}" Text="Health tips you have asked not to see. Turn one back on and Health mentions it again." />

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <TextBlock x:Name="Empty" Style="{StaticResource Muted}" Margin="8" Text="Nothing is ignored." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="Rows">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Turn back on" Style="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding ButtonName}" Click="Restore_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Button x:Name="ResetButton" Grid.Row="4" Content="Reset all" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Click="Reset_Click"
                ToolTip="Turn every ignored tip back on." />
        <Button Grid.Row="4" Content="Close" Style="{StaticResource Primary}" MinWidth="90" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" />
    </Grid>
</Window>
