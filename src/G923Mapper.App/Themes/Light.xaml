<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBack" Color="#F3F4F6" />
    <SolidColorBrush x:Key="CardBack" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#E5E7EB" />
    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#111827" />
    <SolidColorBrush x:Key="TextSecondary" Color="#374151" />
    <SolidColorBrush x:Key="TextMuted" Color="#6B7280" />
    <!-- Accent (primary buttons) -->
    <SolidColorBrush x:Key="Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressed" Color="#1E40AF" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <!-- Secondary buttons -->
    <SolidColorBrush x:Key="SecBack" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecHover" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SecPressed" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SecBorder" Color="#D1D5DB" />
    <!-- Status colours (text and indicators) -->
    <SolidColorBrush x:Key="Success" Color="#16A34A" />
    <SolidColorBrush x:Key="Warn" Color="#D97706" />
    <SolidColorBrush x:Key="Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="Neutral" Color="#6B7280" />
    <!-- Level bars and plots -->
    <SolidColorBrush x:Key="BarTrack" Color="#E5E7EB" />
    <SolidColorBrush x:Key="BarTick" Color="#9CA3AF" />
    <SolidColorBrush x:Key="PlotBack" Color="#F9FAFB" />
    <SolidColorBrush x:Key="PlotBorder" Color="#D1D5DB" />
    <SolidColorBrush x:Key="PlotGrid" Color="#E5E7EB" />
    <SolidColorBrush x:Key="PlotDiagonal" Color="#C7CBD1" />
    <SolidColorBrush x:Key="PlotLine" Color="#2563EB" />
    <!-- Button grid cells -->
    <SolidColorBrush x:Key="CellBack" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CellBorder" Color="#D1D5DB" />
    <SolidColorBrush x:Key="CellLit" Color="#DBEAFE" />
    <SolidColorBrush x:Key="CellLitBorder" Color="#2563EB" />
</ResourceDictionary>
