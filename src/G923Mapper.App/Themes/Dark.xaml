<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBack" Color="#16181D" />
    <SolidColorBrush x:Key="CardBack" Color="#1F2229" />
    <SolidColorBrush x:Key="CardBorder" Color="#2E323B" />
    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TextSecondary" Color="#D1D5DB" />
    <SolidColorBrush x:Key="TextMuted" Color="#9CA3AF" />
    <!-- Accent (primary buttons) -->
    <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHover" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentPressed" Color="#1D4ED8" />
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
    <!-- Secondary buttons -->
    <SolidColorBrush x:Key="SecBack" Color="#2A2E37" />
    <SolidColorBrush x:Key="SecHover" Color="#343945" />
    <SolidColorBrush x:Key="SecPressed" Color="#3D4350" />
    <SolidColorBrush x:Key="SecBorder" Color="#4B5260" />
    <!-- Status colours (text and indicators), lighter for contrast on dark -->
    <SolidColorBrush x:Key="Success" Color="#4ADE80" />
    <SolidColorBrush x:Key="Warn" Color="#FBBF24" />
    <SolidColorBrush x:Key="Danger" Color="#F87171" />
    <SolidColorBrush x:Key="Neutral" Color="#9CA3AF" />
    <!-- Level bars and plots -->
    <SolidColorBrush x:Key="BarTrack" Color="#343945" />
    <SolidColorBrush x:Key="BarTick" Color="#6B7280" />
    <SolidColorBrush x:Key="PlotBack" Color="#1A1D23" />
    <SolidColorBrush x:Key="PlotBorder" Color="#4B5260" />
    <SolidColorBrush x:Key="PlotGrid" Color="#2E323B" />
    <SolidColorBrush x:Key="PlotDiagonal" Color="#4B5260" />
    <SolidColorBrush x:Key="PlotLine" Color="#60A5FA" />
    <!-- Button grid cells -->
    <SolidColorBrush x:Key="CellBack" Color="#2A2E37" />
    <SolidColorBrush x:Key="CellBorder" Color="#4B5260" />
    <SolidColorBrush x:Key="CellLit" Color="#1E3A8A" />
    <SolidColorBrush x:Key="CellLitBorder" Color="#60A5FA" />
</ResourceDictionary>
