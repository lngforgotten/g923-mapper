<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- High contrast: pure black, white outlines and text, gold accent. Every pair here is at least 7:1. -->
    <!-- Surfaces -->
    <SolidColorBrush x:Key="WindowBack" Color="#000000" />
    <SolidColorBrush x:Key="CardBack" Color="#000000" />
    <SolidColorBrush x:Key="CardBorder" Color="#FFFFFF" />
    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextMuted" Color="#D8D8D8" />
    <!-- Accent (primary buttons) and the colour of text on it -->
    <SolidColorBrush x:Key="Accent" Color="#FFD700" />
    <SolidColorBrush x:Key="AccentHover" Color="#FFE766" />
    <SolidColorBrush x:Key="AccentPressed" Color="#E6BE00" />
    <SolidColorBrush x:Key="OnAccent" Color="#000000" />
    <!-- Secondary buttons -->
    <SolidColorBrush x:Key="SecBack" Color="#000000" />
    <SolidColorBrush x:Key="SecHover" Color="#262626" />
    <SolidColorBrush x:Key="SecPressed" Color="#404040" />
    <SolidColorBrush x:Key="SecBorder" Color="#FFFFFF" />
    <!-- Status colours -->
    <SolidColorBrush x:Key="Success" Color="#3DFF7A" />
    <SolidColorBrush x:Key="Warn" Color="#FFD700" />
    <SolidColorBrush x:Key="Danger" Color="#FF7B7B" />
    <SolidColorBrush x:Key="Neutral" Color="#D8D8D8" />
    <!-- Level bars and plots -->
    <SolidColorBrush x:Key="BarTrack" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BarTick" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlotBack" Color="#000000" />
    <SolidColorBrush x:Key="PlotBorder" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PlotGrid" Color="#5A5A5A" />
    <SolidColorBrush x:Key="PlotDiagonal" Color="#B0B0B0" />
    <SolidColorBrush x:Key="PlotLine" Color="#00E5FF" />
    <!-- Button grid cells -->
    <SolidColorBrush x:Key="CellBack" Color="#000000" />
    <SolidColorBrush x:Key="CellBorder" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CellLit" Color="#0050C8" />
    <SolidColorBrush x:Key="CellLitBorder" Color="#00E5FF" />
</ResourceDictionary>
