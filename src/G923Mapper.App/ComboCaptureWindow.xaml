<Window x:Class="G923Mapper.App.ComboCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set button combination" Width="520" Height="330" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Press and hold the wheel buttons you want to use together (two or more is best, so it cannot happen by accident), then let go of all of them." />
                <TextBlock Text="HELD NOW" Style="{StaticResource Caption}" Margin="0,18,0,4" />
                <TextBlock x:Name="TxtHeld" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap" Text="nothing" />
                <TextBlock x:Name="TxtResult" Margin="0,14,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="2">
            <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource Secondary}" IsCancel="True" Click="Cancel_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="RetryButton" Content="Try again" Style="{StaticResource Secondary}" Margin="0,0,8,0" Visibility="Collapsed" Click="Retry_Click" />
                <Button x:Name="UseButton" Content="Use this" Style="{StaticResource Primary}" MinWidth="110" IsEnabled="False" Click="Use_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
