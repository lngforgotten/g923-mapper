<Window x:Class="G923Mapper.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:G923Mapper.App"
        Title="Settings" Width="660" Height="780" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Caption}" />
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,0">

                <!-- Appearance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="APPEARANCE" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeAuto" GroupName="theme" Content="Auto" Margin="0,0,20,0" Checked="Theme_Checked" ToolTip="Follow the Windows light/dark setting" />
                            <RadioButton x:Name="ThemeLight" GroupName="theme" Content="Light" Margin="0,0,20,0" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeDark" GroupName="theme" Content="Dark" Margin="0,0,20,0" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeContrast" GroupName="theme" Content="High contrast" Checked="Theme_Checked" ToolTip="Black and white with a gold accent, for the clearest possible text and outlines" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- General -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="GENERAL" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="StartupBox" Content="Start with Windows (minimised to the tray)" Checked="Startup_Changed" Unchecked="Startup_Changed" />
                        <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" Margin="22,4,0,0" />
                        <CheckBox x:Name="MultiBox" Content="Allow more than one copy (for two wheels)" Margin="0,14,0,0"
                                  Checked="Multi_Changed" Unchecked="Multi_Changed" />
                        <TextBlock x:Name="MultiHint" Style="{StaticResource Hint}" Margin="22,4,0,0"
                                   Text="Off: opening the app again just brings the open one to the front. On: each extra copy drives the next wheel (the second copy the second G923) with its own virtual controller and its own settings, for local co-op. With a single wheel an extra copy would only wait. Applies the next time you start the app." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Open profiles folder" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="OpenProfiles_Click" />
                            <Button Content="Open log folder" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="OpenLogs_Click" />
                            <Button Content="Anti-cheat games…" Style="{StaticResource Secondary}" Click="AntiCheat_Click"
                                    ToolTip="The list of games where keyboard output is never allowed." />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- While playing -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="WHILE PLAYING" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="ReleaseBox" Content="Release the controls when the game is not in front"
                                  Checked="Release_Changed" Unchecked="Release_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0"
                                   Text="When a game's profile is active and you switch to another window, the virtual controller lets go of everything, so a held pedal cannot keep driving the game in the background. It comes back as soon as the game is in front again. Off by default." />
                        <CheckBox x:Name="HotkeyBox" Content="Pause and resume the controller with a shortcut" Margin="0,14,0,0"
                                  Checked="Hotkey_Changed" Unchecked="Hotkey_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                            <ComboBox x:Name="HotkeyCombo" IsEditable="True" Width="190" SelectionChanged="HotkeyCombo_Changed" LostKeyboardFocus="HotkeyCombo_LostFocus" />
                            <TextBlock x:Name="HotkeyMessage" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0"
                                   Text="Works from inside a game. While paused the controller stays connected but every control is released. Off by default; pick or type a shortcut such as Ctrl+Alt+F10." />

                        <CheckBox x:Name="ModeHotkeyBox" Content="Switch to the next mode of a profile with a shortcut" Margin="0,14,0,0"
                                  Checked="ModeHotkey_Changed" Unchecked="ModeHotkey_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="22,8,0,0">
                            <ComboBox x:Name="ModeHotkeyCombo" IsEditable="True" Width="190" SelectionChanged="ModeHotkeyCombo_Changed" LostKeyboardFocus="ModeHotkeyCombo_LostFocus" />
                            <TextBlock x:Name="ModeHotkeyMessage" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0"
                                   Text="A profile can have modes (for example Shooting, Driving, Flying), each with its own rules and feel. This shortcut moves to the next one, from inside a game. A wheel button can do the same with a rule that sends to Mode:Next. Off by default." />
                        <CheckBox x:Name="ModeBuzzBox" Content="Buzz the wheel when the mode changes (once for the first mode, twice for the second, and so on)" Margin="22,8,0,0"
                                  Checked="ModeOptions_Changed" Unchecked="ModeOptions_Changed" />
                        <CheckBox x:Name="ModeToastBox" Content="Show a notification when the mode changes" Margin="22,6,0,0"
                                  Checked="ModeOptions_Changed" Unchecked="ModeOptions_Changed" />

                        <CheckBox x:Name="CombosBox" Content="Use wheel button combinations" Margin="0,14,0,0" Checked="Combos_Changed" Unchecked="Combos_Changed" />
                        <Grid Margin="22,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                            <TextBlock Text="Pause or resume" VerticalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock x:Name="ComboPauseText" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,0,0,6" />
                            <Button Grid.Column="2" Content="Set…" Tag="pause" Style="{StaticResource Secondary}" Margin="8,0,0,6" Click="ComboSet_Click" />
                            <Button Grid.Column="3" Content="Clear" Tag="pause" Style="{StaticResource Secondary}" Margin="6,0,0,6" Click="ComboClear_Click" />

                            <TextBlock Grid.Row="1" Text="Next profile" VerticalAlignment="Center" Margin="0,0,0,6" />
                            <TextBlock x:Name="ComboNextText" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" Margin="0,0,0,6" />
                            <Button Grid.Row="1" Grid.Column="2" Content="Set…" Tag="next" Style="{StaticResource Secondary}" Margin="8,0,0,6" Click="ComboSet_Click" />
                            <Button Grid.Row="1" Grid.Column="3" Content="Clear" Tag="next" Style="{StaticResource Secondary}" Margin="6,0,0,6" Click="ComboClear_Click" />

                            <TextBlock Grid.Row="2" Text="Previous profile" VerticalAlignment="Center" />
                            <TextBlock x:Name="ComboPrevText" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas" />
                            <Button Grid.Row="2" Grid.Column="2" Content="Set…" Tag="previous" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="ComboSet_Click" />
                            <Button Grid.Row="2" Grid.Column="3" Content="Clear" Tag="previous" Style="{StaticResource Secondary}" Margin="6,0,0,0" Click="ComboClear_Click" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0"
                                   Text="Hold the buttons together for about a second to pause the controller or change profile without touching the keyboard. Use buttons your profile does not use, because they still do their normal job while you hold them. Off by default." />
                    </StackPanel>
                </Border>

                <!-- Wheel -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="WHEEL" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="WheelText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Calibrate…" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Calibrate_Click" />
                            <Button Content="Name buttons…" Style="{StaticResource Secondary}" Click="NameButtons_Click" />
                        </StackPanel>
                        <CheckBox x:Name="AutoCentreBox" Content="Keep the wheel centred automatically" Margin="0,14,0,0"
                                  Checked="AutoCentre_Changed" Unchecked="AutoCentre_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0"
                                   Text="A self-centring wheel often settles a degree or two off. When yours has been still for a moment with no pedal pressed, that spot becomes the centre, never more than 3 degrees from the calibrated one. Set centre on the main window still works." />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Calibrate measures your wheel and pedals. Name buttons lets you label each wheel button so profiles are easier to read." />
                    </StackPanel>
                </Border>

                <!-- Force feedback -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="FORCE FEEDBACK" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="FfbBox" Content="Shake the wheel when the game rumbles" Checked="Ffb_Changed" Unchecked="Ffb_Changed" />
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Rumble strength" VerticalAlignment="Center" />
                            <Slider x:Name="RumbleSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10" ValueChanged="Force_ValueChanged" VerticalAlignment="Center" />
                            <TextBlock x:Name="RumbleText" Grid.Column="2" Style="{StaticResource ValueText}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Centring strength" VerticalAlignment="Center" />
                            <Slider x:Name="SpringSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10" ValueChanged="Force_ValueChanged" VerticalAlignment="Center" />
                            <TextBlock x:Name="SpringText" Grid.Column="2" Style="{StaticResource ValueText}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Wheel friction" VerticalAlignment="Center" />
                            <Slider x:Name="FrictionSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="10" ValueChanged="Force_ValueChanged" VerticalAlignment="Center"
                                    ToolTip="A steady resistance to turning the wheel at any speed, like a heavier wheel. It does not pull back to centre." />
                            <TextBlock x:Name="FrictionText" Grid.Column="2" Style="{StaticResource ValueText}" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Centring style" VerticalAlignment="Center" />
                            <ComboBox x:Name="CentringStyleBox" Grid.Column="1" SelectionChanged="CentringStyle_Changed"
                                      ToolTip="Straight spring is the wheel's own spring: simple, and the same pull at every angle. Curve is worked out by this app from where the wheel is, so the pull can build, peak and ease off like a real steering rack." />
                        </Grid>
                        <StackPanel x:Name="CurvePanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Car" VerticalAlignment="Center" />
                                <ComboBox x:Name="CentringPresetBox" Grid.Column="1" SelectionChanged="CentringPreset_Changed"
                                          ToolTip="A starting point for the shape and strength. Change any slider afterwards and it becomes Custom." />
                            </Grid>
                            <TextBlock x:Name="CurveCaption" Style="{StaticResource Muted}" Margin="0,10,0,4" />
                            <local:CentringGraph x:Name="CurveGraph" Height="150" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Centre zone" VerticalAlignment="Center" />
                                <Slider x:Name="CentreSlider" Grid.Column="1" Minimum="1" Maximum="45" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Force_ValueChanged" VerticalAlignment="Center"
                                        ToolTip="Degrees either side of straight ahead over which the pull ramps up from nothing, so the middle is not twitchy." />
                                <TextBlock x:Name="CentreText" Grid.Column="2" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Peak angle" VerticalAlignment="Center" />
                                <Slider x:Name="PeakSlider" Grid.Column="1" Minimum="10" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Force_ValueChanged" VerticalAlignment="Center"
                                        ToolTip="The angle at which the pull is strongest." />
                                <TextBlock x:Name="PeakText" Grid.Column="2" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Lightening" VerticalAlignment="Center" />
                                <Slider x:Name="LightenSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Force_ValueChanged" VerticalAlignment="Center"
                                        ToolTip="How much of the peak pull is left at full lock. 100% means none is lost; lower values let the wheel go lighter the further it is turned." />
                                <TextBlock x:Name="LightenText" Grid.Column="2" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Damping" VerticalAlignment="Center" />
                                <Slider x:Name="DampSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Force_ValueChanged" VerticalAlignment="Center"
                                        ToolTip="Resists fast turns, so the wheel does not swing past the middle when you let go. Keep it small." />
                                <TextBlock x:Name="DampText" Grid.Column="2" Style="{StaticResource ValueText}" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Least pull" VerticalAlignment="Center" />
                                <Slider x:Name="FloorSlider" Grid.Column="1" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Force_ValueChanged" VerticalAlignment="Center"
                                        ToolTip="The weakest pull the curve ever uses away from the middle. Set it to the least force that moves your wheel (Measure does this) and the wheel always comes home." />
                                <TextBlock x:Name="FloorText" Grid.Column="2" Style="{StaticResource ValueText}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="MeasureButton" Content="Measure wheel" Style="{StaticResource Secondary}" Click="Measure_Click"
                                        ToolTip="Take your hands off the wheel first. The force is raised very slowly until the wheel starts to turn; that gives the least pull and which way this wheel pushes. The curve only runs on a wheel that has been measured." />
                                <TextBlock x:Name="MeasureStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="380" />
                            </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Rumble to feel" VerticalAlignment="Center" />
                            <ComboBox x:Name="MotorsBox" Grid.Column="1" SelectionChanged="Motors_Changed"
                                      ToolTip="Games send a heavy, slow rumble and a light, fast one. Choose which the wheel plays: heavy only for big bumps without the buzz, light only for fine texture." />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Vibration style" VerticalAlignment="Center" />
                            <ComboBox x:Name="StyleBox" Grid.Column="1" SelectionChanged="Style_Changed"
                                      ToolTip="Smooth is a hum, Sharp a hard buzz, Rough a rattle. Changing it reconnects the wheel for a moment." />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="TestForceButton" Content="Test vibration" Style="{StaticResource Secondary}" Click="TestForce_Click" />
                            <TextBlock x:Name="FfbStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="The spring gently pulls the wheel back to centre; it starts at 0 so nothing surprises you. Force feedback needs exclusive access to the wheel, so close Logitech G HUB if it will not start. These are the defaults: a profile (or a mode in it) that has its own feel (Edit rules, Feel) uses that instead while it is active, so if a slider here seems to do nothing, check that profile's own feel." />
                    </StackPanel>
                </Border>

                <!-- Hide wheel -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="HIDE THE WHEEL FROM GAMES" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="HideStatus" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="HideButton" Style="{StaticResource Secondary}" Click="Hide_Click" />
                            <TextBlock x:Name="HideMessage" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                        <CheckBox x:Name="UnhideBox" Content="Show the wheel again when this app closes" Margin="0,14,0,0"
                                  Checked="Unhide_Changed" Unchecked="Unhide_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Margin="22,4,0,0"
                                   Text="While the wheel is hidden, Logitech G HUB and other programs cannot see it. Switch this on to hand it back automatically (closing then asks for administrator permission). Switch it off if you want it to stay hidden between sessions." />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Without hiding, a game can see both your real wheel and the virtual controller, so steering can fight itself. Uses HidHide, which asks for administrator permission when it changes anything." />
                    </StackPanel>
                </Border>

                <!-- Virtual controllers -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="VIRTUAL CONTROLLERS" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="PadsStatus" TextWrapping="Wrap" Text="Checking…" />
                        <TextBlock x:Name="PadsList" Style="{StaticResource Muted}" FontFamily="Consolas" Margin="0,6,0,0" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="PadsRefreshButton" Content="Refresh" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="PadsRefresh_Click" />
                            <Button x:Name="PadsRemoveButton" Content="Remove leftovers…" Style="{StaticResource Secondary}" IsEnabled="False" Click="PadsRemove_Click" />
                            <TextBlock x:Name="PadsMessage" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Every virtual Xbox 360 controller on this PC, from any program. A connected one that this app did not make can cause double input in a game. Leftovers are unplugged entries that earlier sessions left in Device Manager; removing them is safe and asks for administrator permission. Real Xbox controllers are never touched." />
                    </StackPanel>
                </Border>

                <!-- Extra devices -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="EXTRA DEVICES" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ExtraEmpty" Style="{StaticResource Muted}" Text="None. A separate handbrake, shifter or pedal set can feed the same virtual controller." />
                        <ListBox x:Name="ExtraList" Height="90" Visibility="Collapsed" Margin="0,0,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Add device…" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="AddDevice_Click" />
                            <Button x:Name="RemoveDeviceButton" Content="Remove" Style="{StaticResource Secondary}" Click="RemoveDevice_Click" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Text="Their inputs appear in profiles as name.input, for example handbrake.pull." />
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ABOUT" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="AboutText" TextWrapping="Wrap" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Updates from" VerticalAlignment="Center" />
                            <TextBox x:Name="UpdateRepoBox" Grid.Column="1" Padding="6,4" TextChanged="UpdateRepo_Changed"
                                     ToolTip="A GitHub repository such as owner/name. Leave empty and the app never looks anything up." />
                            <Button x:Name="UpdateButton" Grid.Column="2" Content="Check for updates" Style="{StaticResource Secondary}" Margin="8,0,0,0" Click="CheckUpdate_Click" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="UpdateMessage" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="UpdateInstallButton" Content="Install now" Style="{StaticResource Primary}" Margin="12,0,0,0" Visibility="Collapsed" Click="InstallUpdate_Click"
                                    ToolTip="Download the new version, then restart into it." />
                            <Button x:Name="UpdateOpenButton" Content="Release page" Style="{StaticResource Secondary}" Margin="8,0,0,0" Visibility="Collapsed" Click="OpenUpdate_Click" />
                        </StackPanel>
                        <CheckBox x:Name="AutoUpdateBox" Content="Check for updates automatically (once a day)" Margin="0,10,0,0" Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" />
                        <CheckBox x:Name="AutoInstallBox" Content="Install new versions automatically" Margin="0,8,0,0" Checked="AutoInstall_Changed" Unchecked="AutoInstall_Changed"
                                  ToolTip="Download a new version in the background and put it in place the next time the app starts. Home also offers Restart now." />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="One request to GitHub for that repository's latest release, a little after start-up and about once a day, with no personal information. With automatic installing on, a new version is downloaded in the background, checked against the checksum GitHub publishes for it, and put in place the next time the app starts (or when you press Restart now on Home); your profiles and settings are kept. Untick it and Home only offers the new version; untick the check as well and the app only looks when you press the button. A copy that is not installed with Setup is never replaced." />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Everything runs on this PC. The app only creates a virtual controller from outside your games; it never touches a game's files or memory." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Done" Style="{StaticResource Primary}" MinWidth="100" IsDefault="True" IsCancel="True" Click="Done_Click" />
        </StackPanel>
    </Grid>
</Window>
