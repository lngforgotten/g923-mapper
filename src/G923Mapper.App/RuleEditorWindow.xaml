<Window x:Class="G923Mapper.App.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:G923Mapper.App"
        Title="Edit profile" Width="1040" Height="860" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="110" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile fields -->
        <Border Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="Profile_Changed" Margin="0,0,16,0" />
                <TextBlock Grid.Column="2" Text="Device" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                <ComboBox x:Name="DeviceBox" Grid.Column="3" SelectionChanged="DeviceBox_Changed" Margin="0,0,16,0" />
                <TextBlock Grid.Column="4" Text="Games" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                <TextBox x:Name="ExeBox" Grid.Column="5" TextChanged="Profile_Changed"
                         ToolTip="Executable names that activate this profile automatically, separated by commas (for example GTA5.exe, GTA5_Enhanced.exe)." />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Safety" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="SafetyBox" Width="190" SelectionChanged="Safety_Changed" VerticalAlignment="Center"
                              ToolTip="Strict: controller mapping only, the safe choice for online games and anti-cheat. Standard: extras such as keyboard output may be used." />
                    <CheckBox x:Name="KeyboardBox" Content="Allow keyboard and mouse output" Margin="16,0,0,0" Checked="Keyboard_Changed" Unchecked="Keyboard_Changed" VerticalAlignment="Center" />
                    <TextBlock x:Name="SafetyHint" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="Games are matched by program name, for example GTA5.exe. Leave empty to use this profile only when chosen by hand." />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Controller" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="PadBox" Width="170" SelectionChanged="Profile_Changed" VerticalAlignment="Center"
                              ToolTip="What the game sees. Match the wheel gives a PlayStation edition wheel a DualShock 4 and any other wheel an Xbox 360 controller. Xbox 360 works with nearly every PC game; DualShock 4 is for games that show PlayStation prompts." />
                    <CheckBox x:Name="SecondPadBox" Content="Second controller" Margin="14,0,0,0" VerticalAlignment="Center" Checked="SecondPad_Changed" Unchecked="SecondPad_Changed"
                              ToolTip="Also show the game a second virtual controller. Rules whose output starts with P2: (listed once this is ticked) feed it, for example the pedals on their own controller." />
                    <TextBlock x:Name="PadHint" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Feel" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <CheckBox x:Name="FeelBox" Content="Own force feedback" VerticalAlignment="Center" Checked="Profile_Changed" Unchecked="Profile_Changed"
                              ToolTip="Tick to give this profile its own rumble strength, centring spring and rumble motors, instead of the ones in Settings. Untick to use the Settings values." />
                    <TextBlock Text="Rumble" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <Slider x:Name="FeelRumble" Width="110" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Feel_Slider" />
                    <TextBlock x:Name="FeelRumbleText" Width="40" Style="{StaticResource ValueText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="Spring" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <Slider x:Name="FeelSpring" Width="110" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Feel_Slider" />
                    <TextBlock x:Name="FeelSpringText" Width="40" Style="{StaticResource ValueText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="Friction" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <Slider x:Name="FeelFriction" Width="90" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Feel_Slider" />
                    <TextBlock x:Name="FeelFrictionText" Width="40" Style="{StaticResource ValueText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <ComboBox x:Name="FeelMotors" Width="150" Margin="12,0,0,0" VerticalAlignment="Center" SelectionChanged="Profile_Changed"
                              ToolTip="Which of the game's two rumble motors the wheel plays." />
                </StackPanel>
                <StackPanel Grid.Row="4" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Wheel" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="HideWheelBox" Width="290" SelectionChanged="Profile_Changed" VerticalAlignment="Center"
                              ToolTip="With HidHide installed, a profile can hide the real wheel from games while its game is running, and give it back afterwards. It never happens just because the profile is selected. Each change asks for administrator permission." />
                    <TextBlock x:Name="HideWheelHint" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel x:Name="ModeRow" Grid.Row="7" Grid.ColumnSpan="6" Margin="0,10,0,0">
                    <TextBlock Text="Editing" Style="{StaticResource FieldLabel}" Margin="0,0,8,4" VerticalAlignment="Center" />
                    <ComboBox x:Name="ViewBox" Width="270" Margin="0,0,0,4" SelectionChanged="View_Changed"
                              ToolTip="The profile's own rules apply in every mode. A mode has rules of its own that apply only while it is active and replace the profile's rules for the same output." />
                    <Button Content="Add mode" Style="{StaticResource Secondary}" Padding="10,4" Margin="10,0,0,4" Click="AddMode_Click"
                            ToolTip="Add a mode such as Shooting, Driving or Flying to this profile." />
                    <Button x:Name="RenameModeButton" Content="Rename" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="RenameMode_Click" />
                    <Button x:Name="DeleteModeButton" Content="Delete mode" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="DeleteMode_Click" />
                    <Button x:Name="EarlierModeButton" Content="Earlier" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="MoveMode_Click" Tag="-1"
                            ToolTip="Move this mode earlier in the order. The first mode is the one a profile starts in." />
                    <Button x:Name="LaterModeButton" Content="Later" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="MoveMode_Click" Tag="1" />
                    <Button x:Name="TurnedOffButton" Content="Profile rules turned off here" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="TurnedOff_Click"
                            ToolTip="Tick any of the profile's rules that should not apply while this mode is active." />
                    <Button x:Name="SwitchRuleButton" Content="Add a switch button" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="SwitchRule_Click"
                            ToolTip="Add a rule so a wheel button moves to the next mode. Press Learn on the new rule to pick the button." />
                    <TextBlock x:Name="ModeNote" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Width="960" />
                </WrapPanel>
                <StackPanel x:Name="TemplateRow" Grid.Row="6" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="Template" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TemplateInfo" VerticalAlignment="Center" />
                    <Button x:Name="TemplateMenuButton" Content="Template options" Style="{StaticResource Secondary}" Padding="12,4" Margin="14,0,0,0" Click="TemplateMenu_Click"
                            ToolTip="See what this profile does its own way, put a rule or setting back to the template's, or take in a changed template." />
                </StackPanel>
                <TextBlock Grid.Row="5" Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,10,8,0" VerticalAlignment="Top" />
                <TextBox x:Name="NotesBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,10,0,0" Height="50" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextChanged="Profile_Changed"
                         ToolTip="Your own notes about this profile, for example what felt right in the game. Kept in the profile file, its history and exports." />
            </Grid>
        </Border>

        <!-- Rules and form -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="RULES" Style="{StaticResource Caption}" Margin="4,0,0,8" />
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button x:Name="AddButton" Content="Add" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Add_Click" />
                        <Button x:Name="DuplicateButton" Content="Duplicate" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Duplicate_Click" />
                        <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource Secondary}" Click="Delete_Click" />
                    </WrapPanel>
                    <ListBox x:Name="RuleList" BorderThickness="0" Background="Transparent" SelectionChanged="RuleList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="2,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid x:Name="FormRoot">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="250" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="From input" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FromBox" IsEditable="True" SelectionChanged="Form_Changed" />
                                    <Button x:Name="LearnButton" Grid.Column="1" Content="Learn" Style="{StaticResource Secondary}"
                                            Margin="8,0,0,0" Padding="14,4" Click="Learn_Click"
                                            ToolTip="Press a button on the wheel, press a pedal, or turn the wheel, and this fills in the input for you." />
                                </Grid>
                                <TextBlock x:Name="LearnHint" Style="{StaticResource Hint}" Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="To output" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <ComboBox x:Name="ToBox" Grid.Row="1" Grid.Column="1" IsEditable="True" Margin="0,0,0,12" SelectionChanged="Form_Changed" />

                            <TextBlock Grid.Row="2" Text="Curve" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <ComboBox x:Name="CurveBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" SelectionChanged="Form_Changed" />

                            <TextBlock x:Name="ExpLabel" Grid.Row="3" Text="Exponent" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel x:Name="ExpPanel" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12">
                                <TextBox x:Name="ExpBox" TextChanged="Form_Changed" />
                                <TextBlock Style="{StaticResource Hint}" Text="Output = input to the power of this. 2 gives a softer start, 1 is linear." />
                            </StackPanel>

                            <TextBlock x:Name="PointsLabel" Grid.Row="4" Text="Points" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel x:Name="PointsPanel" Grid.Row="4" Grid.Column="1" Margin="0,0,0,12">
                                <TextBox x:Name="PointsBox" TextChanged="Form_Changed" />
                                <TextBlock Style="{StaticResource Hint}" Text="Pairs of input,output from 0 to 1, left to right, for example: 0,0 0.5,0.2 1,1" />
                            </StackPanel>

                            <TextBlock Grid.Row="5" Text="Deadzone %" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,0,0,12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBox x:Name="DeadzoneBox" Grid.Column="1" TextChanged="Form_Changed" /></Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="A percentage of travel, 0 to 99 (for example 4). Input at or below this counts as zero. Needed in front of an anti-deadzone." />
                            </StackPanel>

                            <TextBlock Grid.Row="6" Text="Anti-deadzone %" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,0,0,12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><Slider x:Name="AntiSlider" Minimum="0" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBox x:Name="AntiBox" Grid.Column="1" TextChanged="Form_Changed" /></Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="A percentage, for example 6. Skips the game's own deadzone: any movement starts at this much output." />
                            </StackPanel>

                            <TextBlock Grid.Row="7" Text="Wheel range" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel Grid.Row="7" Grid.Column="1" Margin="0,0,0,12">
                                <TextBox x:Name="RangeBox" TextChanged="Form_Changed" />
                                <TextBlock Style="{StaticResource Hint}" Text="Degrees of wheel travel that give full stick (wheel only). Empty = the whole lock-to-lock rotation." />
                            </StackPanel>

                            <TextBlock Grid.Row="8" Text="Invert" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <CheckBox x:Name="InvertBox" Grid.Row="8" Grid.Column="1" Margin="0,2,0,12" VerticalAlignment="Center"
                                      Content="Flip the direction" Checked="Form_Changed" Unchecked="Form_Changed" />

                            <TextBlock x:Name="ThresholdLabel" Grid.Row="9" Text="Press at %" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel x:Name="ThresholdPanel" Grid.Row="9" Grid.Column="1" Margin="0,0,0,12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions><Slider x:Name="ThresholdSlider" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" /><TextBox x:Name="ThresholdBox" Grid.Column="1" TextChanged="Form_Changed" /></Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="The trigger point, for button, key and mouse outputs: press once the input reaches this percentage of its travel. 35 is about a third of the way down; 50 if empty. Negative (for example -50) = at or below, for the wheel turning left." />
                            </StackPanel>

                            <TextBlock x:Name="ModeLabel" Grid.Row="10" Text="Button mode" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel x:Name="ModePanel" Grid.Row="10" Grid.Column="1" Margin="0,0,0,12">
                                <ComboBox x:Name="ModeBox" SelectionChanged="Form_Changed" />
                                <TextBlock Style="{StaticResource Hint}" Text="Hold: pressed while held. Toggle: each press flips it. Pulse: one short press per physical press." />
                                <StackPanel x:Name="PulsePanel" Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="Pulse length (ms)" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                    <TextBox x:Name="PulseBox" Width="80" TextChanged="Form_Changed" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="TurboLabel" Grid.Row="11" Text="Turbo" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel x:Name="TurboPanel" Grid.Row="11" Grid.Column="1" Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="TurboBox" Content="Press and release repeatedly while held" VerticalAlignment="Center"
                                              Checked="Form_Changed" Unchecked="Form_Changed" />
                                    <TextBox x:Name="TurboHzBox" Width="50" Margin="12,0,6,0" TextChanged="Form_Changed" />
                                    <TextBlock Text="per second" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="TurboHint" Style="{StaticResource Hint}" />
                            </StackPanel>

                            <TextBlock x:Name="SmoothLabel" Grid.Row="14" Text="Smoothing (ms)" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel x:Name="SmoothPanel" Grid.Row="14" Grid.Column="1" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                                    <Slider x:Name="SmoothSlider" Minimum="0" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBox x:Name="SmoothBox" Grid.Column="1" TextChanged="Form_Changed" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Optional. Glides the stick or trigger towards where the input is, with this time constant. It takes out jitter and sudden jumps but adds a little delay, so for steering keep it small (0 = off)." />
                            </StackPanel>

                            <TextBlock Grid.Row="13" Text="Axis part" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel Grid.Row="13" Grid.Column="1" Margin="0,0,0,12">
                                <ComboBox x:Name="PartBox" SelectionChanged="Form_Changed" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Use only one half of the axis, stretched to full range. Positive half = the wheel turned right (or the upper half of a pedal axis); negative half = turned left (or the lower half). Handy for splitting one combined axis into two controls." />
                            </StackPanel>

                            <TextBlock Grid.Row="12" Text="Expression" Style="{StaticResource FieldLabel}" Margin="0,0,0,12" />
                            <StackPanel Grid.Row="12" Grid.Column="1" Margin="0,0,0,12">
                                <TextBox x:Name="ExprBox" TextChanged="Form_Changed" FontFamily="Consolas" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Optional. Replaces the input with a calculation: x is the input above, other names are other inputs. For example max(0, x) takes the positive half of a combined pedal axis, and max(0, -x) the other half. Also + - * / ( ), min, max, abs, clamp, sqrt, pow." />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RESPONSE" Style="{StaticResource Caption}" />
                        <local:CurvePreview x:Name="Preview" Width="230" Height="230" HorizontalAlignment="Left" />
                        <TextBlock x:Name="PreviewNote" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="Shows deadzone, curve and anti-deadzone. Left to right is the input, bottom to top is the output." />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Problems -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CHECKS" Style="{StaticResource Caption}" Margin="0,0,0,6" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="IssueList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,0,0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="6">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="2,0,0,0"
                       Text="Saving rewrites the file in a tidy layout, drops any comments, and keeps a .bak copy of the old version." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource Primary}" MinWidth="100" Click="Save_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
