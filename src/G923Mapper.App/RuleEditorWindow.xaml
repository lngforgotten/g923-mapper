<Window x:Class="G923Mapper.App.RuleEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:G923Mapper.App"
        xmlns:s="clr-namespace:System;assembly=System.Runtime"
        Title="Edit profile" Width="1200" Height="980" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Muted}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <!-- A box of settings that belong together, in the rule form. -->
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="GroupCaption" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="TopLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <!-- The explanations: shown on hover, and read out by screen readers. -->
        <s:String x:Key="HelpExponent">Output = input to the power of this. 2 gives a softer start, 1 is linear.</s:String>
        <s:String x:Key="HelpPoints">Pairs of input,output from 0 to 1, left to right, for example: 0,0 0.5,0.2 1,1</s:String>
        <s:String x:Key="HelpDeadzone">A percentage of travel, 0 to 99 (for example 4). Input at or below this counts as zero. Needed in front of an anti-deadzone.</s:String>
        <s:String x:Key="HelpAnti">A percentage, for example 6. Skips the game's own deadzone: any movement starts at this much output.</s:String>
        <s:String x:Key="HelpSmooth">Optional. Glides the stick or trigger towards where the input is, with this time constant. It takes out jitter and sudden jumps but adds a little delay, so for steering keep it small (0 = off).</s:String>
        <s:String x:Key="HelpThreshold">The trigger point, for button, key and mouse outputs: press once the input reaches this percentage of its travel. 35 is about a third of the way down; 50 if empty. Negative (for example -50) = at or below, for the wheel turning left.</s:String>
        <s:String x:Key="HelpMode">Hold: pressed while held. Toggle: each press flips it. Pulse: one short press per physical press.</s:String>
        <s:String x:Key="HelpPart">Use only one half of the axis, stretched to full range. Positive half = the wheel turned right (or the upper half of a pedal axis); negative half = turned left (or the lower half). Handy for splitting one combined axis into two controls.</s:String>
        <s:String x:Key="HelpRange">Degrees of wheel travel that give full stick (wheel only). Empty = the whole lock-to-lock rotation.</s:String>
        <s:String x:Key="HelpExpression">Optional. Replaces the input with a calculation: x is the input above, other names are other inputs. For example max(0, x) takes the positive half of a combined pedal axis, and max(0, -x) the other half. Also + - * / ( ), min, max, abs, clamp, sqrt, pow.</s:String>
    </Window.Resources>

    <Grid x:Name="Root" Margin="16" SizeChanged="Layout_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile fields. The rules come first: in a window too short for both, this block scrolls (see Layout_SizeChanged). -->
        <ScrollViewer x:Name="HeaderScroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <Border Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="1.3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="Profile_Changed" Margin="0,0,16,0" />
                <TextBlock Grid.Column="2" Text="Device" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                <ComboBox x:Name="DeviceBox" Grid.Column="3" SelectionChanged="DeviceBox_Changed" Margin="0,0,16,0" />
                <TextBlock Grid.Column="4" Text="Games" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                <TextBox x:Name="ExeBox" Grid.Column="5" TextChanged="Profile_Changed"
                         ToolTip="Executable names that activate this profile automatically, separated by commas (for example GTA5.exe, GTA5_Enhanced.exe)." />
                <WrapPanel Grid.Row="1" Grid.ColumnSpan="6" Margin="0,10,0,0">
                    <TextBlock Text="Safety" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="SafetyBox" Width="190" SelectionChanged="Safety_Changed" VerticalAlignment="Center"
                              ToolTip="Strict: controller mapping only, the safe choice for online games and anti-cheat. Standard: extras such as keyboard output may be used." />
                    <CheckBox x:Name="KeyboardBox" Content="Allow keyboard and mouse output" Margin="16,0,0,0" Checked="Keyboard_Changed" Unchecked="Keyboard_Changed" VerticalAlignment="Center" />
                    <TextBlock x:Name="SafetyHint" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="Games are matched by program name, for example GTA5.exe. Leave empty to use this profile only when chosen by hand." />
                </WrapPanel>
                <WrapPanel Grid.Row="2" Grid.ColumnSpan="6" Margin="0,10,0,0">
                    <TextBlock Text="Controller" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="PadBox" Width="170" SelectionChanged="Profile_Changed" VerticalAlignment="Center"
                              ToolTip="What the game sees. Match the wheel gives a PlayStation edition wheel a DualShock 4 and any other wheel an Xbox 360 controller. Xbox 360 works with nearly every PC game; DualShock 4 is for games that show PlayStation prompts." />
                    <CheckBox x:Name="SecondPadBox" Content="Second controller" Margin="14,0,0,0" VerticalAlignment="Center" Checked="SecondPad_Changed" Unchecked="SecondPad_Changed"
                              ToolTip="Also show the game a second virtual controller. Rules whose output starts with P2: (listed once this is ticked) feed it, for example the pedals on their own controller." />
                    <TextBlock x:Name="PadHint" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="6" Margin="0,10,0,0">
                <WrapPanel>
                    <TextBlock Text="Feel" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <CheckBox x:Name="FeelBox" Content="Own force feedback" VerticalAlignment="Center" Checked="Profile_Changed" Unchecked="Profile_Changed"
                              ToolTip="Tick to give this profile its own rumble, centring, friction and rumble motors, instead of the ones in Settings. Untick to use the Settings values." />
                    <TextBlock Text="Rumble" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <Slider x:Name="FeelRumble" Width="110" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Feel_Slider" />
                    <TextBlock x:Name="FeelRumbleText" Width="40" Style="{StaticResource ValueText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="Centring" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <Slider x:Name="FeelSpring" Width="110" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Feel_Slider" />
                    <TextBlock x:Name="FeelSpringText" Width="40" Style="{StaticResource ValueText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <TextBlock Text="Friction" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <Slider x:Name="FeelFriction" Width="90" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="Feel_Slider" />
                    <TextBlock x:Name="FeelFrictionText" Width="40" Style="{StaticResource ValueText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <ComboBox x:Name="FeelMotors" Width="150" Margin="12,0,0,0" VerticalAlignment="Center" SelectionChanged="Profile_Changed"
                              ToolTip="Which of the game's two rumble motors the wheel plays." />
                </WrapPanel>
                <!-- Which kind of centring this feel uses. Only shown while the profile or mode has its own feel. -->
                <WrapPanel x:Name="FeelCentringRow" Margin="0,8,0,0">
                    <TextBlock Text="Centring style" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="FeelCentringBox" Width="200" VerticalAlignment="Center" SelectionChanged="FeelCentring_Changed"
                              AutomationProperties.Name="Centring style"
                              ToolTip="Straight spring is the wheel's own spring. Curve is a shaped pull that builds, peaks and eases off like a real steering rack." />
                    <StackPanel x:Name="FeelCurvePanel" Orientation="Horizontal" Margin="12,0,0,0">
                        <TextBlock Text="Car" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="FeelCarBox" Width="210" VerticalAlignment="Center" SelectionChanged="FeelCar_Changed" AutomationProperties.Name="Car preset"
                                  ToolTip="A starting point for the shape and strength: the built-in presets and the ones you saved in Settings." />
                        <Button Content="Adjust curve&#8230;" Style="{StaticResource Secondary}" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center" Click="FeelShape_Click" />
                    </StackPanel>
                    <TextBlock x:Name="FeelCurveNote" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                               Text="Your wheel is not measured yet, so it gets the straight spring. In Settings, set Centring style to Curve and press Measure wheel." />
                </WrapPanel>
                </StackPanel>
                <WrapPanel Grid.Row="4" Grid.ColumnSpan="6" Margin="0,10,0,0">
                    <TextBlock Text="Wheel" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <ComboBox x:Name="HideWheelBox" Width="290" SelectionChanged="Profile_Changed" VerticalAlignment="Center"
                              ToolTip="With HidHide installed, a profile can hide the real wheel from games while its game is running, and give it back afterwards. It never happens just because the profile is selected. Each change asks for administrator permission." />
                    <CheckBox x:Name="LeaveWheelBox" Content="Leave the wheel alone" Margin="16,0,0,0" VerticalAlignment="Center" Checked="Profile_Changed" Unchecked="Profile_Changed"
                              ToolTip="For a game with its own wheel support (force feedback included). While this profile is in use the mapper lets go of the wheel and creates no virtual controller, so the game has the wheel to itself. The profile's rules do nothing." />
                    <CheckBox x:Name="KeepKeysBox" Content="but still send keys and mouse" Margin="12,0,0,0" VerticalAlignment="Center" Checked="Profile_Changed" Unchecked="Profile_Changed"
                              ToolTip="Still read the wheel, without taking it over, and send the keyboard and mouse rules (for example a gear shifter that presses keys) while the game keeps the wheel and its force feedback. There is no virtual controller, so rules that send to it do nothing. Keyboard output needs Standard safety." />
                    <TextBlock x:Name="HideWheelHint" TextWrapping="Wrap" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel x:Name="ModeRow" Grid.Row="7" Grid.ColumnSpan="6" Margin="0,10,0,0">
                    <TextBlock Text="Editing" Style="{StaticResource FieldLabel}" Margin="0,0,8,4" VerticalAlignment="Center" />
                    <ComboBox x:Name="ViewBox" Width="270" Margin="0,0,0,4" SelectionChanged="View_Changed"
                              ToolTip="The profile's own rules apply in every mode. A mode has rules of its own that apply only while it is active and replace the profile's rules for the same output." />
                    <Button Content="Add mode" Style="{StaticResource Secondary}" Padding="10,4" Margin="10,0,0,4" Click="AddMode_Click"
                            ToolTip="Add a mode such as Shooting, Driving or Flying to this profile." />
                    <Button x:Name="RenameModeButton" Content="Rename" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="RenameMode_Click" />
                    <Button x:Name="DeleteModeButton" Content="Delete mode" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="DeleteMode_Click" />
                    <Button x:Name="EarlierModeButton" Content="Earlier" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="MoveMode_Click" Tag="-1"
                            ToolTip="Move this mode earlier in the order. The first mode is the one a profile starts in." />
                    <Button x:Name="LaterModeButton" Content="Later" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="MoveMode_Click" Tag="1" />
                    <Button x:Name="TurnedOffButton" Content="Profile rules turned off here" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="TurnedOff_Click"
                            ToolTip="Tick any of the profile's rules that should not apply while this mode is active." />
                    <Button x:Name="SwitchRuleButton" Content="Add a switch button" Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="SwitchRule_Click"
                            ToolTip="Add a rule so a wheel button moves to the next mode. Press Learn on the new rule to pick the button." />
                    <Button x:Name="ModeShortcutsButton" Content="Mode shortcuts..." Style="{StaticResource Secondary}" Padding="10,4" Margin="6,0,0,4" Click="ModeShortcuts_Click"
                            ToolTip="Keyboard keys and mouse buttons that switch this profile's modes while it runs. Games bind different keys, so this profile can have its own, or use the app-wide ones from Settings." />
                    <TextBlock x:Name="ModeNote" Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap" Width="{Binding ActualWidth, ElementName=ModeRow}" />
                </WrapPanel>
                <WrapPanel x:Name="TemplateRow" Grid.Row="6" Grid.ColumnSpan="6" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="Template" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                    <TextBlock x:Name="TemplateInfo" VerticalAlignment="Center" />
                    <Button x:Name="TemplateMenuButton" Content="Template options" Style="{StaticResource Secondary}" Padding="12,4" Margin="14,0,0,0" Click="TemplateMenu_Click"
                            ToolTip="See what this profile does its own way, put a rule or setting back to the template's, or take in a changed template." />
                </WrapPanel>
                <TextBlock Grid.Row="5" Text="Notes" Style="{StaticResource FieldLabel}" Margin="0,8,8,0" />
                <!-- One line high on purpose: it still takes several lines, scrolled with the arrow keys or the mouse wheel. -->
                <TextBox x:Name="NotesBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="5" Margin="0,8,0,0" MaxLines="1" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Hidden" TextChanged="Profile_Changed"
                         ToolTip="Your own notes about this profile, for example what felt right in the game. Kept in the profile file, its history and exports. Enter starts a new line; the arrow keys and mouse wheel scroll through them." />
            </Grid>
        </Border>
        </ScrollViewer>

        <!-- Rules and form -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="260" MaxWidth="440" /><ColumnDefinition Width="12" /><ColumnDefinition Width="7*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="RULES" Style="{StaticResource Caption}" Margin="4,0,0,8" />
                    <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <Button x:Name="AddButton" Content="Add" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Add_Click" />
                        <Button x:Name="DuplicateButton" Content="Duplicate" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Duplicate_Click" />
                        <Button x:Name="DeleteButton" Content="Delete" Style="{StaticResource Secondary}" Click="Delete_Click" />
                    </WrapPanel>
                    <ListBox x:Name="RuleList" BorderThickness="0" Background="Transparent" SelectionChanged="RuleList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="2,3" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- The selected rule: what to what across the top, then its settings in groups, with the response graph beside them. -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid x:Name="FormRoot">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="From" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                            <ComboBox x:Name="FromBox" Grid.Column="1" IsEditable="True" SelectionChanged="Form_Changed" AutomationProperties.Name="From input" />
                            <Button x:Name="LearnButton" Grid.Column="2" Content="Learn" Style="{StaticResource Secondary}" Margin="8,0,0,0" Padding="14,4" Click="Learn_Click"
                                    ToolTip="Press a button on the wheel, press a pedal, or turn the wheel, and this fills in the input for you." />
                            <TextBlock Grid.Column="3" Text="→  To" Style="{StaticResource FieldLabel}" Margin="14,0,8,0" />
                            <ComboBox x:Name="ToBox" Grid.Column="4" IsEditable="True" SelectionChanged="Form_Changed" AutomationProperties.Name="To output" />
                        </Grid>
                        <TextBlock x:Name="LearnHint" Style="{StaticResource Hint}" Visibility="Collapsed" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" MinWidth="220" MaxWidth="560" /></Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,12,0">

                                <!-- Sticks and triggers -->
                                <Border x:Name="ResponseGroup" Style="{StaticResource Group}">
                                    <StackPanel>
                                        <TextBlock Text="RESPONSE CURVE" Style="{StaticResource GroupCaption}" />
                                        <TextBlock x:Name="ResponseWhy" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                                                   Text="These do nothing for a button, key or mode output. They are shown because one of them needs putting right (see Checks)." />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Curve" Style="{StaticResource TopLabel}" />
                                                <ComboBox x:Name="CurveBox" HorizontalAlignment="Stretch" SelectionChanged="Form_Changed" AutomationProperties.Name="Curve" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="ExpLabel" Text="Exponent (1 = linear)" Style="{StaticResource TopLabel}" />
                                                <StackPanel x:Name="ExpPanel">
                                                    <TextBox x:Name="ExpBox" TextChanged="Form_Changed" ToolTip="{StaticResource HelpExponent}"
                                                             AutomationProperties.Name="Exponent" AutomationProperties.HelpText="{StaticResource HelpExponent}" />
                                                </StackPanel>
                                                <TextBlock x:Name="PointsLabel" Text="Points (input,output)" Style="{StaticResource TopLabel}" />
                                                <StackPanel x:Name="PointsPanel">
                                                    <TextBox x:Name="PointsBox" TextChanged="Form_Changed" ToolTip="{StaticResource HelpPoints}"
                                                             AutomationProperties.Name="Points" AutomationProperties.HelpText="{StaticResource HelpPoints}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel Background="Transparent" ToolTip="{StaticResource HelpDeadzone}">
                                                <TextBlock Text="Deadzone %" Style="{StaticResource TopLabel}" />
                                                <DockPanel>
                                                    <TextBox x:Name="DeadzoneBox" DockPanel.Dock="Right" Width="52" TextChanged="Form_Changed"
                                                             AutomationProperties.Name="Deadzone percent" AutomationProperties.HelpText="{StaticResource HelpDeadzone}" />
                                                    <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="Deadzone" />
                                                </DockPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Background="Transparent" ToolTip="{StaticResource HelpAnti}">
                                                <TextBlock Text="Anti-deadzone %" Style="{StaticResource TopLabel}" />
                                                <DockPanel>
                                                    <TextBox x:Name="AntiBox" DockPanel.Dock="Right" Width="52" TextChanged="Form_Changed"
                                                             AutomationProperties.Name="Anti-deadzone percent" AutomationProperties.HelpText="{StaticResource HelpAnti}" />
                                                    <Slider x:Name="AntiSlider" Minimum="0" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="Anti-deadzone" />
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Text="Hover over a setting to see what it does." />
                                        <TextBlock x:Name="SmoothLabel" Text="Smoothing (ms, 0 = off)" Style="{StaticResource TopLabel}" Margin="0,8,0,3" />
                                        <StackPanel x:Name="SmoothPanel" Background="Transparent" ToolTip="{StaticResource HelpSmooth}">
                                            <DockPanel>
                                                <TextBox x:Name="SmoothBox" DockPanel.Dock="Right" Width="52" TextChanged="Form_Changed"
                                                         AutomationProperties.Name="Smoothing in milliseconds" AutomationProperties.HelpText="{StaticResource HelpSmooth}" />
                                                <Slider x:Name="SmoothSlider" Minimum="0" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="Smoothing" />
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Buttons, keys, mouse buttons and mode switches -->
                                <Border x:Name="PressGroup" Style="{StaticResource Group}">
                                    <StackPanel>
                                        <TextBlock Text="BUTTON PRESS" Style="{StaticResource GroupCaption}" />
                                        <TextBlock x:Name="PressWhy" Style="{StaticResource Hint}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="Collapsed"
                                                   Text="These do nothing for a stick or trigger output. They are shown because one of them needs putting right (see Checks)." />
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel Background="Transparent" ToolTip="{StaticResource HelpThreshold}">
                                                <TextBlock x:Name="ThresholdLabel" Text="Press at %" Style="{StaticResource TopLabel}" />
                                                <StackPanel x:Name="ThresholdPanel">
                                                    <DockPanel>
                                                        <TextBox x:Name="ThresholdBox" DockPanel.Dock="Right" Width="52" TextChanged="Form_Changed"
                                                                 AutomationProperties.Name="Press at percent" AutomationProperties.HelpText="{StaticResource HelpThreshold}" />
                                                        <Slider x:Name="ThresholdSlider" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,6,0" AutomationProperties.Name="Press at" />
                                                    </DockPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Background="Transparent" ToolTip="{StaticResource HelpMode}">
                                                <TextBlock x:Name="ModeLabel" Text="Button mode" Style="{StaticResource TopLabel}" />
                                                <StackPanel x:Name="ModePanel">
                                                    <ComboBox x:Name="ModeBox" HorizontalAlignment="Stretch" SelectionChanged="Form_Changed"
                                                              AutomationProperties.Name="Button mode" AutomationProperties.HelpText="{StaticResource HelpMode}" />
                                                    <StackPanel x:Name="PulsePanel" Orientation="Horizontal" Margin="0,8,0,0">
                                                        <TextBlock Text="Pulse (ms)" Style="{StaticResource FieldLabel}" Margin="0,0,8,0" />
                                                        <TextBox x:Name="PulseBox" Width="70" TextChanged="Form_Changed" AutomationProperties.Name="Pulse length in milliseconds" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Text="Press at: 50 if empty. Negative means the wheel turning left." />
                                        <TextBlock x:Name="TurboLabel" Text="Turbo" Style="{StaticResource TopLabel}" Margin="0,8,0,3" />
                                        <StackPanel x:Name="TurboPanel">
                                            <WrapPanel>
                                                <CheckBox x:Name="TurboBox" Content="Press and release repeatedly while held" Checked="Form_Changed" Unchecked="Form_Changed" />
                                                <TextBox x:Name="TurboHzBox" Width="50" Margin="12,0,6,0" TextChanged="Form_Changed" AutomationProperties.Name="Turbo presses per second" />
                                                <TextBlock Text="per second" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                                            </WrapPanel>
                                            <TextBlock x:Name="TurboHint" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- How the input is read, whatever it drives -->
                                <Border x:Name="InputGroup" Style="{StaticResource Group}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="INPUT" Style="{StaticResource GroupCaption}" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                            <StackPanel Background="Transparent" ToolTip="{StaticResource HelpPart}">
                                                <TextBlock Text="Axis part" Style="{StaticResource TopLabel}" />
                                                <ComboBox x:Name="PartBox" HorizontalAlignment="Stretch" SelectionChanged="Form_Changed"
                                                          AutomationProperties.Name="Axis part" AutomationProperties.HelpText="{StaticResource HelpPart}" />
                                            </StackPanel>
                                            <StackPanel x:Name="RangeRow" Grid.Column="2" Background="Transparent" ToolTip="{StaticResource HelpRange}">
                                                <TextBlock Text="Wheel range (degrees)" Style="{StaticResource TopLabel}" />
                                                <TextBox x:Name="RangeBox" TextChanged="Form_Changed" AutomationProperties.Name="Wheel range in degrees" AutomationProperties.HelpText="{StaticResource HelpRange}" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox x:Name="InvertBox" Content="Invert (flip the direction)" Checked="Form_Changed" Unchecked="Form_Changed" />
                                        <TextBlock Text="Expression (optional, x = the input)" Style="{StaticResource TopLabel}" Margin="0,6,0,3" />
                                        <TextBox x:Name="ExprBox" TextChanged="Form_Changed" FontFamily="Consolas" ToolTip="{StaticResource HelpExpression}"
                                                 AutomationProperties.Name="Expression" AutomationProperties.HelpText="{StaticResource HelpExpression}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <local:SquarePlotPanel x:Name="PlotPanel" Grid.Column="2">
                            <TextBlock Text="RESPONSE" Style="{StaticResource Caption}" />
                            <local:CurvePreview x:Name="Preview" />
                            <TextBlock x:Name="PreviewNote" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       Text="Shows deadzone, curve and anti-deadzone. Left to right is the input, bottom to top is the output." />
                        </local:SquarePlotPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Checks, what Apply and Save do, and the buttons -->
        <DockPanel x:Name="BottomBar" Grid.Row="4" SizeChanged="Layout_SizeChanged">
            <!-- Like the health badge on the main window: a dot and a count, and the list on a click. -->
            <Button x:Name="ChecksButton" DockPanel.Dock="Left" Style="{StaticResource Secondary}" Padding="12,8" Margin="0,0,12,0" VerticalAlignment="Center"
                    Click="Checks_Click" ToolTip="See what the checks found in this profile." />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="RevertButton" Content="Revert to start" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Revert_Click" IsEnabled="False"
                        ToolTip="Put the profile back exactly as it was when you opened this window, and close it. Only available once you have applied something." />
                <Button Content="Cancel" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="ApplyButton" Content="Apply" Style="{StaticResource Secondary}" MinWidth="90" Margin="0,0,8,0" Click="Apply_Click"
                        ToolTip="Use these changes now (the mapper reloads the profile) and keep this window open." />
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource Primary}" MinWidth="100" Click="Save_Click" />
            </StackPanel>
            <TextBlock x:Name="ApplyNote" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="640"
                       Text="Apply puts your changes into use now and keeps this window open, so you can try them in the game, tweak and apply again. Save does the same and closes. Saving rewrites the file in a tidy layout, drops any comments, and keeps a .bak copy of the old version." />
        </DockPanel>
    </Grid>
</Window>



