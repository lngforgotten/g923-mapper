<Window x:Class="G923Mapper.App.AddModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a mode" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel Margin="16">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="START FROM" Style="{StaticResource Caption}" />
                <ListBox x:Name="PresetList" BorderThickness="0" Background="Transparent" SelectionChanged="Preset_Changed" DisplayMemberPath="Name" Height="130" />
                <TextBlock x:Name="TxtDescription" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock x:Name="TxtKeys" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Warn}" Visibility="Collapsed"
                           Text="This mode presses keys. They only work when the profile's Safety is Standard with keyboard output on (offline and single-player games only)." />
                <TextBlock x:Name="TxtDisplaced" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" />

                <TextBlock Text="NAME" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                <TextBox x:Name="NameBox" Padding="8,6" TextChanged="Name_Changed" />
                <TextBlock x:Name="TxtProblem" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource Secondary}" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="AddButton" Content="Add mode" Style="{StaticResource Primary}" MinWidth="110" IsDefault="True" Click="Add_Click" />
        </StackPanel>
    </StackPanel>
</Window>
