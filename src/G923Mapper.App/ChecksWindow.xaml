<Window x:Class="G923Mapper.App.ChecksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checks" Width="620" Height="440" MinWidth="440" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="Summary" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Problems (✗) have to be fixed before the profile can be saved. Warnings (⚠) do not stop you saving, but something will not work the way it is written." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Button Grid.Row="4" Content="Close" Style="{StaticResource Primary}" MinWidth="90" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="Close_Click" />
    </Grid>
</Window>
