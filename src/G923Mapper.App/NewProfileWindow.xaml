<Window x:Class="G923Mapper.App.NewProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New profile" Width="600" Height="560" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Start from a template" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Pick the closest one. Everything can be changed afterwards with Edit rules." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ListBox x:Name="PresetList" BorderThickness="0" Background="Transparent" SelectionChanged="PresetList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="6,6" AutomationProperties.Name="{Binding Title}">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Name" VerticalAlignment="Center" Margin="2,0,10,0" />
            <TextBox x:Name="NameBox" Grid.Column="1" Padding="6,5" VerticalContentAlignment="Center" Margin="0,0,14,0" TextChanged="NameBox_TextChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Cancel" Style="{StaticResource Secondary}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="CreateButton" Content="Create" Style="{StaticResource Primary}" MinWidth="90" IsDefault="True" Click="Create_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
