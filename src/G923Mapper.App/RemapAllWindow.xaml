<Window x:Class="G923Mapper.App.RemapAllWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:G923Mapper.App"
        Title="Remap all" Width="820" Height="700" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Remap all" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Goes through the controls of the virtual controller one at a time. The picture shows which one it is asking about (the amber ring). Press the wheel button or pedal you want for it, or turn the wheel. Skip anything you do not need; at the end it makes a new profile." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- The picture -->
                <StackPanel>
                    <local:PadDiagram x:Name="PadView" Width="360" Height="216" HorizontalAlignment="Left" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Ellipse Width="12" Height="12" Stroke="{DynamicResource Warn}" StrokeThickness="2.5" Margin="0,0,6,0" />
                        <TextBlock Text="asking about" Style="{StaticResource Muted}" Margin="0,0,16,0" />
                        <Ellipse Width="12" Height="12" Stroke="{DynamicResource Success}" StrokeThickness="2" Margin="0,0,6,0" />
                        <TextBlock Text="already chosen" Style="{StaticResource Muted}" />
                    </StackPanel>
                </StackPanel>

                <!-- The question -->
                <DockPanel Grid.Column="2">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="TxtStep" Style="{StaticResource Caption}" Text="STARTING" />
                        <TextBlock x:Name="TxtPrompt" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="" />
                        <TextBlock x:Name="TxtHint" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap" Text="" />
                        <TextBlock x:Name="TxtGot" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Success}" />
                        <ProgressBar x:Name="Progress" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1" Value="0" />
                        <StackPanel x:Name="NamePanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <TextBlock Text="Name for the new profile" Style="{StaticResource Muted}" />
                            <TextBox x:Name="NameBox" Padding="8,6" FontSize="14" Margin="0,4,0,0" Text="My layout" />
                        </StackPanel>
                        <TextBlock Text="CHOSEN SO FAR" Style="{StaticResource Caption}" Margin="0,16,0,6" />
                    </StackPanel>
                    <ListBox x:Name="ChosenList" ItemContainerStyle="{StaticResource CompactItem}" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextSecondary}" FontFamily="Consolas" FontSize="12" />
                </DockPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4">
            <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource Secondary}" IsCancel="True" Click="Cancel_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="Skip" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Skip_Click" />
                <Button x:Name="FinishButton" Content="Finish now" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Finish_Click" />
                <Button x:Name="CreateButton" Content="Create profile" Style="{StaticResource Primary}" MinWidth="130" Visibility="Collapsed" Click="Create_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
