<Window x:Class="G923Mapper.App.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Get started" Width="700" Height="760" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Get started" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtSummary" Margin="0,4,0,0" TextWrapping="Wrap" Text="Checking..." />
                <ProgressBar x:Name="Progress" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1" Value="0" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Each step updates by itself as you do it. You can come back to this from the More menu on the Home tab at any time." />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" />
        </ScrollViewer>

        <DockPanel Grid.Row="4">
            <Button Content="Check again" DockPanel.Dock="Left" Style="{StaticResource Secondary}" Click="Check_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource Secondary}" Margin="0,0,8,0" IsCancel="True" Click="Close_Click" />
                <Button x:Name="DoneButton" Content="Done, do not show again" Style="{StaticResource Primary}" Click="Done_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
