<Window x:Class="G923Mapper.App.HealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Health" Width="640" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="Summary" FontSize="17" FontWeight="SemiBold" Text="Checking…" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Everything this app depends on, in plain language. Anything that needs attention is listed first." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Rows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,10" AutomationProperties.Name="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Symbol}" Foreground="{Binding Brush}" FontSize="16" FontWeight="Bold" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="2" Content="{Binding ActionText}" Visibility="{Binding ActionVisibility}"
                                        Style="{StaticResource Secondary}" Margin="12,0,0,0" VerticalAlignment="Top" Click="Action_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save report…" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="SaveReport_Click"
                    ToolTip="Save these findings and the recent log to a text file you can send to someone." />
            <Button Content="Check again" Style="{StaticResource Secondary}" Margin="0,0,8,0" Click="Refresh_Click" />
            <Button Content="Close" Style="{StaticResource Primary}" MinWidth="90" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
