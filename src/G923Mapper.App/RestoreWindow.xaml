<Window x:Class="G923Mapper.App.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore a previous version" Width="620" Height="520" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="17" FontWeight="SemiBold" Text="Earlier versions" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Every time this profile changes, the version it had before is kept here, so a bad edit can be undone. Restoring one keeps the version it replaces, so you can change your mind again." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock x:Name="TxtNone" DockPanel.Dock="Top" Style="{StaticResource Muted}" Visibility="Collapsed"
                           Text="No earlier versions yet. They appear after the profile has been changed." TextWrapping="Wrap" />
                <ListBox x:Name="Versions" BorderThickness="0" Background="Transparent" SelectionChanged="Versions_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding When}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4">
            <Button Content="Cancel" DockPanel.Dock="Left" Style="{StaticResource Secondary}" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="RestoreButton" Content="Restore this version" HorizontalAlignment="Right" Style="{StaticResource Primary}" IsEnabled="False" Click="Restore_Click" />
        </DockPanel>
    </Grid>
</Window>
