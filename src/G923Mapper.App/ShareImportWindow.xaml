<Window x:Class="G923Mapper.App.ShareImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paste a profile" Width="580" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <StackPanel Margin="16">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="THIS PROFILE" Style="{StaticResource Caption}" />
                <TextBlock x:Name="TxtSummary" TextWrapping="Wrap" FontWeight="SemiBold" />

                <TextBlock Text="SAVE AS" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                <TextBox x:Name="NameBox" Padding="8,6" TextChanged="NameBox_Changed" />
                <TextBlock x:Name="TxtNameNote" Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />

                <StackPanel x:Name="OffPanel" Margin="0,14,0,0">
                    <TextBlock Text="SWITCHED OFF ON THE WAY IN" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="TxtOff" TextWrapping="Wrap" Foreground="{DynamicResource Warn}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="A profile from somewhere else never turns these on by itself. Turn them on in Edit rules once you have checked it, if you want them." />
                </StackPanel>

                <StackPanel x:Name="CalPanel" Margin="0,14,0,0">
                    <TextBlock Text="WHEEL CALIBRATION" Style="{StaticResource Caption}" />
                    <CheckBox x:Name="CalBox" />
                    <TextBlock x:Name="TxtCal" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel x:Name="NotePanel" Margin="0,14,0,0">
                    <TextBlock Text="NOTES" Style="{StaticResource Caption}" />
                    <TextBlock x:Name="TxtNotes" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource Secondary}" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="SaveButton" Content="Save profile" Style="{StaticResource Primary}" MinWidth="130" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
