<Window x:Class="G923Mapper.App.CalibrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:G923Mapper.App"
        Title="Calibrate wheel" Width="640" Height="600" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBack}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Calibrate your wheel" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                           Text="Follow each instruction, then click Record. For the stops, push the wheel or pedal firmly to its end and hold it until the meter fills. If you have limited the steering angle in Logitech G HUB, turn only to the stop it sets." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="TxtPhase" Style="{StaticResource Caption}" Text="STARTING" />
                    <TextBlock x:Name="TxtPrompt" FontSize="16" TextWrapping="Wrap" Text="Looking for your wheel…" />
                    <ProgressBar x:Name="Progress" Height="6" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                    <StackPanel x:Name="LivePanel" Margin="0,14,0,0" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock x:Name="TxtLiveValue" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontFamily="Consolas" Text="" />
                            <TextBlock Text="Where it is now" Style="{StaticResource Muted}" />
                        </DockPanel>
                        <local:CentreBar x:Name="LiveBar" Bipolar="True" Margin="0,5,0,0" />
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="end" Style="{StaticResource Muted}" FontSize="11" />
                            <TextBlock Text="end" Style="{StaticResource Muted}" FontSize="11" />
                        </DockPanel>
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock x:Name="TxtHoldPct" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontFamily="Consolas" Text="0%" />
                            <TextBlock Text="Hold steady" Style="{StaticResource Muted}" />
                        </DockPanel>
                        <ProgressBar x:Name="HoldBar" Height="8" Margin="0,5,0,0" Minimum="0" Maximum="1" Value="0" />
                        <TextBlock x:Name="TxtLive" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="AskPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBox x:Name="AskBox" Padding="8,6" FontSize="14" KeyDown="AskBox_KeyDown" />
                    </StackPanel>
                    <ItemsControl x:Name="ReportList" Margin="0,14,0,0" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="Consolas" Margin="0,0,0,3" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="NOTES" Style="{StaticResource Caption}" Margin="0,18,0,6" />
                </StackPanel>
                <ListBox x:Name="Notes" ItemContainerStyle="{StaticResource CompactItem}" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextSecondary}" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4">
            <Button x:Name="CancelButton" DockPanel.Dock="Left" Content="Cancel" Style="{StaticResource Secondary}" Click="CancelButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="UseButton" Content="Use this position" Style="{StaticResource Secondary}" Margin="0,0,8,0" Visibility="Collapsed" IsEnabled="False" Click="UseButton_Click" />
                <Button x:Name="SkipButton" Content="Skip" Style="{StaticResource Secondary}" Margin="0,0,8,0" Visibility="Collapsed" Click="SkipButton_Click" />
                <Button x:Name="DiscardButton" Content="Discard" Style="{StaticResource Secondary}" Margin="0,0,8,0" Visibility="Collapsed" Click="DiscardButton_Click" />
                <Button x:Name="PrimaryButton" Content="Record" Style="{StaticResource Primary}" MinWidth="110" IsEnabled="False" Click="PrimaryButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
